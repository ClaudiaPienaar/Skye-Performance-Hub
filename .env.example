# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL this app is deployed at (used to build magic-link redirect URLs).
# Set to your Vercel URL in production, e.g. https://skye-performance-hub.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
